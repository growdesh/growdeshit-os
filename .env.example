# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Optional CORS allowlist (comma-separated origins, e.g. https://os.growdeshit.com)
CORS_ORIGIN=

# MySQL Database Configuration (Hostinger Business Hosting / Local MySQL)
# Leave DB_HOST empty to run with the built-in local preview store.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Authentication & Security
# Set a strong 32+ character random secret in production.
# Admin credentials are stored and managed strictly in the MySQL database.
JWT_SECRET=
JWT_EXPIRES_IN=7d
